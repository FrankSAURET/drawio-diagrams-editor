# ============================================================
# .vscodeignore — ne garder dans le VSIX que le strict nécessaire :
#   dist/ (code compilé), runtime webapp drawio (offline),
#   README/CHANGELOG/LICENSE/PRIVACY, nls, icône, media/.
# ============================================================

# Contrôle de version
.git/**
.github/**
.gitattributes
.gitignore
.gitmodules

# Formatage
.prettierignore
.prettierrc.json

# Configuration VS Code dev
.vscode/**

# Code source TypeScript (compilé dans dist/)
src/**
drawio-custom-plugins/**

# Cartes de source et paquets déjà construits
dist/**/*.map
**/*.vsix

# Sous-module drawio : tout exclure puis réinclure UNIQUEMENT le runtime
# chargé par la webview offline (webview-content.html) et les chargements
# dynamiques de app.min.js (mermaid, orgchart, jquery, deflate, simplepeer,
# jszip, MathJax/math4, stencils, ressources i18n, images).
# Exclus volontairement : sources dev (js/diagramly, js/grapheditor,
# mxgraph/src, shapes/), bundles inutilisés (integrate.min.js, viewer*.min.js),
# WEB-INF (serveur), templates (dialogue inaccessible en mode embed),
# SDK cloud (onedrive/dropbox), service-worker/workbox.
drawio/**
!drawio/LICENSE
!drawio/src/main/webapp/js/PreConfig.js
!drawio/src/main/webapp/js/PostConfig.js
!drawio/src/main/webapp/js/app.min.js
!drawio/src/main/webapp/js/extensions.min.js
!drawio/src/main/webapp/js/stencils.min.js
!drawio/src/main/webapp/js/shapes-14-6-5.min.js
!drawio/src/main/webapp/js/orgchart.min.js
!drawio/src/main/webapp/js/orgchart/**
!drawio/src/main/webapp/js/mermaid/**
!drawio/src/main/webapp/js/jquery/**
!drawio/src/main/webapp/js/deflate/**
!drawio/src/main/webapp/js/jszip/**
!drawio/src/main/webapp/js/simplepeer/**
!drawio/src/main/webapp/styles/**
!drawio/src/main/webapp/images/**
!drawio/src/main/webapp/img/**
!drawio/src/main/webapp/mxgraph/css/**
!drawio/src/main/webapp/mxgraph/images/**
!drawio/src/main/webapp/resources/**
!drawio/src/main/webapp/stencils/**
!drawio/src/main/webapp/math4/**
!drawio/src/main/webapp/plugins/**

# Outils de build & dépendances dev
node_modules/**
webpack.config.ts
tsconfig.json
tslint.json
yarn.lock
scripts/**

# Exemples & notes de développement
examples/**
NOTES.md
architecture.drawio.svg
debug.log
README original.md

# docs/ : seule l'icône est embarquée. Les images du README sont réécrites
# par vsce en URLs GitHub absolues (champ "repository"), inutile de les livrer.
docs/**
!docs/Logo-drawio-diagrams-editor.png
